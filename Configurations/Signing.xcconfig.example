// Code Signing Configuration
// Copy this file to Signing.xcconfig and fill in your values.
// Use MOEPEEK_ prefix to avoid being overridden by Tuist defaults.
//
// This fork (macOS 12/13 support) removes Sparkle, so no EdDSA key is needed.
// For local development, ad-hoc signing works: MOEPEEK_CODE_SIGN_IDENTITY = -

MOEPEEK_CODE_SIGN_STYLE = Manual
MOEPEEK_CODE_SIGN_IDENTITY = -
MOEPEEK_DEVELOPMENT_TEAM =
